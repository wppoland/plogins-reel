#. Plugin Name of the plugin
#: plogins-reel.php
msgid "Plogins Reel - Product Gallery Zoom & Video for WooCommerce"
msgstr "Plogins Reel - powiększanie galerii produktu i wideo dla WooCommerce"

#. Plugin URI of the plugin
#: plogins-reel.php
msgid "https://plogins.com/plogins-reel/"
msgstr "https://plogins.com/plogins-reel/"

#. Description of the plugin
#: plogins-reel.php
msgid ""
"Hover zoom, lightbox and featured video for the WooCommerce product gallery: "
"reserved space, no jQuery."
msgstr "Powiększanie po najechaniu, lightbox i wyróżnione wideo dla galerii produktu WooCommerce: zarezerwowane miejsce, bez jQuery."

#. Author of the plugin
#: plogins-reel.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-reel.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-reel.php:45
msgid "Settings"
msgstr "Ustawienia"

#: plogins-reel.php:65
msgid "Reel requires WooCommerce to be active."
msgstr "Reel wymaga, aby WooCommerce był aktywny."

#: src/Admin/ProductVideoFields.php:47 src/Admin/Settings.php:85
msgid "Reel"
msgstr "Reel"

#: src/Admin/ProductVideoFields.php:69
msgid "Video URL"
msgstr "Adres URL wideo"

#: src/Admin/ProductVideoFields.php:71
msgid ""
"A YouTube or Vimeo link, or a direct .mp4/.webm file URL. It shows in the "
"gallery area on the product page. Leave empty for no video."
msgstr "Link do YouTube lub Vimeo albo bezpośredni adres pliku .mp4/.webm. Pokazuje się w obszarze galerii na stronie produktu. Pozostaw puste, aby nie było wideo."

#: src/Admin/ProductVideoFields.php:79
msgid "Video heading (optional)"
msgstr "Nagłówek wideo (opcjonalny)"

#: src/Admin/ProductVideoFields.php:80
msgid "e.g. See it in action"
msgstr "np. Zobacz produkt w akcji"

#: src/Admin/ProductVideoFields.php:81
msgid ""
"Heading shown above the video. Leave empty to use the default from Reel "
"settings."
msgstr "Nagłówek pokazywany nad wideo. Pozostaw puste, aby użyć domyślnego z ustawień Reel."

#: src/Admin/ProUpsell.php:78
msgid "Wkrótce"
msgstr "Wkrótce"

#: src/Admin/ProUpsell.php:78
